---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Gabriel Rubens. Developer and Product Owner, shipping products on the side.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

// GA4. Production builds only, and only when PUBLIC_GA_ID is set, so localhost and preview
// builds never pollute the numbers. That contamination is not hypothetical: the portfolio's
// own Lighthouse CI silently poisoned GotHired's PostHog pageview funnels for weeks.
const gaId = import.meta.env.PROD ? import.meta.env.PUBLIC_GA_ID : undefined;

const navLinks = [
  { href: '/',                 label: 'home',     match: (p: string) => p === '/' },
  { href: '/projects',         label: 'projects', match: (p: string) => p.startsWith('/projects') },
  { href: '/writing',          label: 'writing',  match: (p: string) => p.startsWith('/writing') },
  { href: '/impossible-list',  label: 'impossible list', match: (p: string) => p.startsWith('/impossible-list') },
  { href: '/about',            label: 'about',    match: (p: string) => p === '/about' },
  { href: '/uses',             label: 'uses',     match: (p: string) => p === '/uses' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/x-icon" href="/assets/favicon/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/favicon/site.webmanifest" />
    <meta name="theme-color" content="#f2f2f0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          // Consent Mode v2. Analytics only: every advertising signal stays denied, so nothing
          // here feeds ad profiles. See docs/analytics.md for what this does and does not cover.
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'granted',
          });
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <div class="shell">
      <aside class="chrome">
        <a href="/" class="wordmark">
          Gabriel<br /><em>Rubens.</em>
        </a>
        <div class="meta-line"><span class="dot"></span>portugal · via brazil</div>
        <nav class="primary" aria-label="Primary">
          {navLinks.map(({ href, label, match }) => (
            <a href={href} aria-current={match(pathname) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </aside>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
